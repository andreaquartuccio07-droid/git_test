# --- Obbligatori ---------------------------------------------------------
# Chiave API di Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Segreto dell'app Meta (developers.facebook.com → la tua app → Impostazioni → Di base)
WHATSAPP_APP_SECRET=
# Una parola scelta da te, da inserire anche nella configurazione del webhook su Meta
WHATSAPP_VERIFY_TOKEN=
# Token per creare i lead via API (almeno 24 caratteri, es. da: openssl rand -hex 24)
ADMIN_TOKEN=

# --- Facoltativi ----------------------------------------------------------
# Token di accesso WhatsApp. Se manca, i messaggi vengono solo scritti a terminale.
WHATSAPP_TOKEN=
# Database (stringa di connessione Postgres di Supabase). Se manca, archivio in memoria.
DATABASE_URL=
# Solo senza DATABASE_URL: phone_number_id del numero WhatsApp del salone demo
DEMO_WHATSAPP_PHONE_NUMBER_ID=
# Secondi di attesa prima di rispondere, per raccogliere più messaggi ravvicinati
ATTESA_RISPOSTA_SECONDI=8
# Modello Claude usato per capire i messaggi
LLM_MODEL=claude-opus-5-5
PORT=3000
